@{
    ViewData["Title"] = "Класифікація тварин";
}

<div class="text-center">
    <h1>Класифікація зображення</h1>

    <form asp-controller="Animal" asp-action="Index" method="post" enctype="multipart/form-data">

        <div>
            <label>Оберіть зображення:</label>
            <input type="file" name="image" accept="image/*" />
        </div>

        <br />

        <div>
            <label>Або введіть посилання на зображення:</label>
            <input type="text" name="imageUrl" style="width: 400px;" />
        </div>

        <br />

        <button type="submit">Класифікувати</button>

    </form>

    @if (ViewBag.Error != null)
    {
        <p>@ViewBag.Error</p>
    }

    @if (ViewBag.Result != null)
    {
        <div>
            <h2>Результат</h2>
            <p>Клас: <strong>@ViewBag.Result</strong></p>
            <p>Впевненість: <strong>@ViewBag.Confidence.ToString("F2")%</strong></p>
        </div>
    }
</div>